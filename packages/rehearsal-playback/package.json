{
  "name": "@org/rehearsal-playback",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "rehearsal-playback",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/package-lock.json"
        ],
        "options": {
          "cwd": "packages/rehearsal-playback",
          "command": "tsx --test src/lib/rehearsal-playback.spec.ts"
        }
      }
    }
  },
  "dependencies": {
    "@org/rehearsal-domain": "^0.0.1",
    "@react-native-async-storage/async-storage": "^3.0.2"
  }
}
