EXPO_PUBLIC_APP_SCHEME=choirlms
EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.choirlms.mobile
EXPO_PUBLIC_ANDROID_PACKAGE=com.choirlms.mobile
# Google OAuth client mapping for manual testing:
# - EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID: iOS OAuth client for bundle ID `com.choirlms.mobile`
# - EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID: Android OAuth client for package `com.choirlms.mobile`
#   and the SHA-1 of the signing key used by the dev build
# - EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID: only required when running the app on web
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_DRIVE_SUPPORTED_MIME_TYPES=audio/mpeg,audio/mp4,audio/x-m4a,audio/wav,audio/x-wav,audio/aac,audio/flac,audio/ogg
EXPO_PUBLIC_GOOGLE_DRIVE_SUPPORTED_EXTENSIONS=mp3,m4a,wav,aac,flac,ogg