{
  "name": "@org/mobile-rehearsal-player",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . packages/mobile-rehearsal-player",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "nx": {
    "name": "mobile-rehearsal-player",
    "targets": {
      "typecheck-config": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.config.json",
          "{projectRoot}/app.config.ts",
          "{projectRoot}/src/config/**/*.ts"
        ],
        "options": {
          "cwd": "packages/mobile-rehearsal-player",
          "command": "tsc --noEmit -p tsconfig.config.json"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.app.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/package-lock.json"
        ],
        "options": {
          "cwd": "packages/mobile-rehearsal-player",
          "command": "tsc -b tsconfig.json"
        }
      },
      "typecheck-tests": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/tsconfig.spec.json",
          "{projectRoot}/tsconfig.json",
          "{projectRoot}/src/**/*.spec.ts",
          "{projectRoot}/src/**/*.spec.tsx",
          "{workspaceRoot}/package-lock.json"
        ],
        "options": {
          "cwd": "packages/mobile-rehearsal-player",
          "command": "tsc --noEmit -p tsconfig.spec.json"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/package-lock.json"
        ],
        "outputs": [
          "{workspaceRoot}/packages/mobile-rehearsal-player/dist"
        ],
        "options": {
          "cwd": "packages/mobile-rehearsal-player",
          "command": "expo export --clear"
        }
      },
      "eas-build": {
        "executor": "@nx/expo:build",
        "cache": false,
        "options": {}
      },
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/package-lock.json"
        ],
        "options": {
          "cwd": "packages/mobile-rehearsal-player",
          "command": "tsx --test 'src/**/*.spec.ts' 'src/**/*.spec.tsx'"
        }
      },
      "lint": {
        "dependsOn": [
          "typecheck-config",
          "typecheck"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/metro-config": "*",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@org/audio-library-runtime": "^0.0.1",
    "@org/google-drive": "^0.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@testing-library/react-native": "*",
    "es-toolkit": "^1.46.1",
    "expo": "*",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "expo-web-browser": "~15.0.11",
    "jest-expo": "*",
    "lodash.debounce": "^4.0.8",
    "metro-config": "*",
    "metro-resolver": "*",
    "react": "19.1.0",
    "react-native": "*",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-track-player": "^4.1.2",
    "react-native-web": "*"
  },
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9"
  }
}
