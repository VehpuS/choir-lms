{
  "name": "@org/rehearsal-domain",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "rehearsal-domain",
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/package-lock.json"
        ],
        "options": {
          "cwd": "packages/rehearsal-domain",
          "command": "tsx --test src/lib/rehearsal-domain.spec.ts"
        }
      }
    }
  },
  "dependencies": {}
}
