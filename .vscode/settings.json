{
  "cSpell.words": ["Agentic", "checkpointed", "LINTABLE", "openspec"],
  "chat.tools.terminal.autoApprove": {
    "/^npx nx show/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^npm exec nx (?:test|lint|typecheck)/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^npm exec -- nx run-many -t (?:test|lint|typecheck)(?:,(?:test|lint|typecheck))*/": {
      "approve": true,
      "matchCommandLine": true
    },
